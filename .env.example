# Explicit runtime identity. Hosted projects must never infer this from
# VERCEL_ENV because permanent QA also deploys to Vercel's production target.
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=development

# This landing and the application it hands visitors to.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The server and public selectors must identify the same Convex deployment.
CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Environment-owned commercial contact. No production fallback exists.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# QA uses a distinct cookie name and host-only scope. Production uses
# cookieConsent plus .flowo.com.br to share an explicit choice with the app.
NEXT_PUBLIC_CONSENT_COOKIE_NAME=flowoLocalConsent
NEXT_PUBLIC_FLOWO_COOKIE_DOMAIN=host-only

# Anti-abuse. Missing Turnstile is allowed only in local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics and ad identities must be dedicated per environment or left blank.
NEXT_PUBLIC_SEGMENT_WRITE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Environment-owned observability. Partial Sentry configuration is rejected by
# the preflight; leaving all fields blank disables delivery.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TUNNEL_ROUTE=0

# Centralized error monitoring. The public key is embedded only in the
# browser error-monitoring client; the server key is secret/build-only.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_RELEASE=

# Optional search verification belongs only to the production public site.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
